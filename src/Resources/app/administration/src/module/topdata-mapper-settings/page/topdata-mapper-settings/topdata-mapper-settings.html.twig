{% block topdata_mapper_settings %}
    <sw-page class="topdata-mapper-settings">
        <template #smart-bar-header>
            <h2>{{ $tc('TopdataMapperSW6.settings.title') }}</h2>
        </template>

        <template #smart-bar-actions>
            <sw-button
                variant="primary"
                :isLoading="isSaving"
                :disabled="isSaving || !validationValid || !isDirty"
                @click="save"
            >
                {{ $tc('TopdataMapperSW6.settings.save.button') }}
            </sw-button>
        </template>

        <template #content>
            <sw-card-view>
                <sw-loader v-if="isLoading" class="topdata-mapper-settings__loader"/>

                {% block topdata_mapper_settings_credentials_card %}
                    <sw-card
                        :title="$tc('TopdataMapperSW6.settings.credentials.title')"
                        :subtitle="$tc('TopdataMapperSW6.settings.credentials.subtitle')"
                    >
                        <sw-container columns="1fr auto" align="center" gap="0 24px">
                            <p class="topdata-mapper-settings__credentials-text">
                                {{ $tc('TopdataMapperSW6.settings.credentials.status') }}
                                <sw-label
                                    v-if="credentialsConfigured"
                                    variant="success"
                                    appearance="pill"
                                >
                                    {{ $tc('TopdataMapperSW6.settings.credentials.configured') }}
                                </sw-label>
                                <sw-label
                                    v-else
                                    variant="danger"
                                    appearance="pill"
                                >
                                    {{ $tc('TopdataMapperSW6.settings.credentials.notConfigured') }}
                                </sw-label>
                            </p>

                            <sw-button
                                variant="ghost"
                                :router-link="{ name: 'sw.extension.config', params: { namespace: 'TopdataMapperSW6' } }"
                            >
                                {{ $tc('TopdataMapperSW6.settings.credentials.openConfig') }}
                            </sw-button>
                        </sw-container>
                    </sw-card>
                {% endblock %}

                {% block topdata_mapper_settings_strategy_card %}
                    <sw-card
                        :title="$tc('TopdataMapperSW6.settings.strategy.title')"
                        :subtitle="$tc('TopdataMapperSW6.settings.strategy.subtitle')"
                    >
                        {% block topdata_mapper_settings_presets %}
                            <div class="topdata-mapper-settings__presets">
                                <sw-button
                                    v-for="preset in presets"
                                    :key="preset.key"
                                    size="small"
                                    :variant="preset.key === activePresetKey ? 'primary' : 'ghost'"
                                    @click="onPresetClick(preset)"
                                >
                                    {{ $tc('TopdataMapperSW6.settings.strategy.preset.' + preset.key, 0, preset.label) }}
                                </sw-button>
                            </div>
                        {% endblock %}

                        {% block topdata_mapper_settings_dsl %}
                            <div class="topdata-mapper-settings__dsl">
                                <sw-textarea-field
                                    ref="dslTextarea"
                                    v-model="dsl"
                                    :label="$tc('TopdataMapperSW6.settings.dsl.label')"
                                    :helpText="$tc('TopdataMapperSW6.settings.dsl.helpText')"
                                    rows="5"
                                    placeholder="product.ean:ean | product.manufacturer_number:mpn"
                                />
                                <div class="topdata-mapper-settings__dsl-actions">
                                    <sw-button
                                        size="small"
                                        variant="ghost"
                                        :disabled="isCopying"
                                        @click="copyDsl"
                                    >
                                        <sw-icon name="regular-copy" size="14"/>
                                        {{ $tc('TopdataMapperSW6.settings.dsl.copy') }}
                                    </sw-button>
                                    <sw-button
                                        size="small"
                                        variant="ghost"
                                        @click="openDslHelp"
                                    >
                                        <sw-icon name="regular-question-circle" size="14"/>
                                        {{ $tc('TopdataMapperSW6.settings.dsl.help') }}
                                    </sw-button>
                                </div>
                            </div>
                        {% endblock %}

                        {% block topdata_mapper_settings_validation %}
                            <sw-alert
                                v-if="!validationValid && validationError"
                                variant="error"
                                :title="$tc('TopdataMapperSW6.settings.validation.title')"
                            >
                                {{ validationError.message }}
                                <template v-if="validationError.shopField">
                                    <br>{{ $tc('TopdataMapperSW6.settings.validation.shopField') }}: {{ validationError.shopField }}
                                </template>
                                <template v-if="validationError.dimension">
                                    <br>{{ $tc('TopdataMapperSW6.settings.validation.dimension') }}: {{ validationError.dimension }}
                                </template>
                                <template v-if="validationError.position !== undefined && validationError.position !== null">
                                    <br>{{ $tc('TopdataMapperSW6.settings.validation.position') }}: {{ validationError.position }}
                                </template>
                            </sw-alert>

                            <sw-alert
                                v-if="saveError"
                                variant="error"
                                :title="$tc('TopdataMapperSW6.settings.save.failedTitle')"
                            >
                                {{ saveError.message }}
                                <template v-if="saveError.shopField">
                                    <br>{{ $tc('TopdataMapperSW6.settings.validation.shopField') }}: {{ saveError.shopField }}
                                </template>
                                <template v-if="saveError.dimension">
                                    <br>{{ $tc('TopdataMapperSW6.settings.validation.dimension') }}: {{ saveError.dimension }}
                                </template>
                            </sw-alert>
                        {% endblock %}
                    </sw-card>
                {% endblock %}
            </sw-card-view>

            {% block topdata_mapper_settings_dirty_confirm %}
                <sw-modal
                    v-if="showDirtyConfirm"
                    variant="small"
                    :title="$tc('TopdataMapperSW6.settings.dirtyConfirm.title')"
                    @modal-close="cancelPreset"
                >
                    <p>{{ $tc('TopdataMapperSW6.settings.dirtyConfirm.message') }}</p>

                    <template #modal-footer>
                        <sw-button
                            variant="primary"
                            @click="confirmPreset"
                        >
                            {{ $tc('TopdataMapperSW6.settings.dirtyConfirm.confirm') }}
                        </sw-button>
                        <sw-button
                            variant="ghost"
                            @click="cancelPreset"
                        >
                            {{ $tc('TopdataMapperSW6.settings.dirtyConfirm.cancel') }}
                        </sw-button>
                    </template>
                </sw-modal>
            {% endblock %}

            {% block topdata_mapper_settings_dsl_help %}
                <sw-modal
                    v-if="showDslHelp"
                    variant="large"
                    class="topdata-mapper-settings__dsl-help"
                    :title="$tc('TopdataMapperSW6.settings.dslHelp.title')"
                    @modal-close="closeDslHelp"
                >
                    <p>{{ $tc('TopdataMapperSW6.settings.dslHelp.intro') }}</p>

                    <h3>{{ $tc('TopdataMapperSW6.settings.dslHelp.grammar.title') }}</h3>
                    <p>{{ $tc('TopdataMapperSW6.settings.dslHelp.grammar.leaf') }}</p>
                    <p class="topdata-mapper-settings__dsl-help-code">
                        <code>shopField:dimension</code>
                    </p>
                    <ul>
                        <li>
                            <code>&amp;</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.grammar.and') }}
                        </li>
                        <li>
                            <code>|</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.grammar.or') }}
                        </li>
                        <li>
                            <code>( )</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.grammar.parens') }}
                        </li>
                    </ul>

                    <h3>{{ $tc('TopdataMapperSW6.settings.dslHelp.shopFields.title') }}</h3>
                    <ul>
                        <li><code>product.ean</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.shopFields.ean') }}</li>
                        <li><code>product.manufacturer_number</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.shopFields.manufacturerNumber') }}</li>
                        <li><code>product.manufacturer</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.shopFields.manufacturer') }}</li>
                        <li><code>product.product_number</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.shopFields.productNumber') }}</li>
                        <li><code>property.&lt;group&gt;</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.shopFields.property') }}</li>
                        <li><code>customField.&lt;name&gt;</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.shopFields.customField') }}</li>
                    </ul>

                    <h3>{{ $tc('TopdataMapperSW6.settings.dslHelp.dimensions.title') }}</h3>
                    <ul>
                        <li><code>ean</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.dimensions.ean') }}</li>
                        <li><code>mpn</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.dimensions.mpn') }}</li>
                        <li><code>pcd</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.dimensions.pcd') }}</li>
                        <li><code>articleNumbers</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.dimensions.articleNumbers') }}</li>
                        <li><code>topdataBrandIds</code> — {{ $tc('TopdataMapperSW6.settings.dslHelp.dimensions.brandIds') }}</li>
                    </ul>

                    <h3>{{ $tc('TopdataMapperSW6.settings.dslHelp.pairings.title') }}</h3>
                    <p>{{ $tc('TopdataMapperSW6.settings.dslHelp.pairings.intro') }}</p>
                    <ul>
                        <li v-for="(dimensions, kind) in allowedPairs" :key="kind">
                            <code>{{ kind }}</code> ↔ {{ dimensions.map(dimensionLabel).join(', ') }}
                        </li>
                    </ul>
                    <p>{{ $tc('TopdataMapperSW6.settings.dslHelp.pairings.providerScope') }}</p>

                    <h3>{{ $tc('TopdataMapperSW6.settings.dslHelp.examples.title') }}</h3>
                    <ul class="topdata-mapper-settings__dsl-help-examples">
                        <li>
                            <p class="topdata-mapper-settings__dsl-help-code">
                                <code>product.ean:ean | product.manufacturer_number:mpn</code>
                            </p>
                            <p>{{ $tc('TopdataMapperSW6.settings.dslHelp.examples.one') }}</p>
                        </li>
                        <li>
                            <p class="topdata-mapper-settings__dsl-help-code">
                                <code>product.ean:ean &amp; product.manufacturer:topdataBrandIds</code>
                            </p>
                            <p>{{ $tc('TopdataMapperSW6.settings.dslHelp.examples.two') }}</p>
                        </li>
                        <li>
                            <p class="topdata-mapper-settings__dsl-help-code">
                                <code>product.product_number:articleNumbers.4123</code>
                            </p>
                            <p>{{ $tc('TopdataMapperSW6.settings.dslHelp.examples.three') }}</p>
                        </li>
                        <li>
                            <p class="topdata-mapper-settings__dsl-help-code">
                                <code>(product.ean:ean | product.product_number:articleNumbers.4123) &amp; product.manufacturer:topdataBrandIds</code>
                            </p>
                            <p>{{ $tc('TopdataMapperSW6.settings.dslHelp.examples.four') }}</p>
                        </li>
                    </ul>

                    <template #modal-footer>
                        <sw-button
                            variant="primary"
                            @click="closeDslHelp"
                        >
                            {{ $tc('TopdataMapperSW6.settings.dslHelp.close') }}
                        </sw-button>
                    </template>
                </sw-modal>
            {% endblock %}
        </template>
    </sw-page>
{% endblock %}
